# ============================================================
# Cron Jobs para GPS Tracker Platform
# ============================================================
# Instalar com: crontab /home/tomelin/rastreador/scripts/cron/backup-cron
# Ou adicionar ao crontab existente com: cat >> /etc/cron.d/gps-tracker
# ============================================================

# Variaveis de ambiente
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Diretorio base
BACKUP_DIR=/home/tomelin/rastreador/backups
SCRIPT_DIR=/home/tomelin/rastreador/scripts
LOG_DIR=/home/tomelin/rastreador/logs

# ============ BACKUPS ============

# Backup diario as 03:00
0 3 * * * root ${SCRIPT_DIR}/backup.sh >> ${LOG_DIR}/backup.log 2>&1

# ============ MANUTENCAO ============

# Limpar logs antigos (mais de 30 dias) - Domingos as 04:00
0 4 * * 0 root find ${LOG_DIR} -name "*.log" -mtime +30 -delete 2>/dev/null

# Vacuum do PostgreSQL - Domingos as 05:00
0 5 * * 0 root docker exec rastreador-db psql -U postgres -d rastreador_db -c "VACUUM ANALYZE;" >> ${LOG_DIR}/maintenance.log 2>&1

# Reindexar tabelas grandes - Primeiro domingo do mes as 06:00
0 6 1-7 * 0 root docker exec rastreador-db psql -U postgres -d rastreador_db -c "REINDEX TABLE localizacoes;" >> ${LOG_DIR}/maintenance.log 2>&1

# ============ MONITORAMENTO ============

# Verificar saude dos containers - A cada 5 minutos
*/5 * * * * root docker ps --filter "name=rastreador" --format "{{.Names}}: {{.Status}}" >> ${LOG_DIR}/health.log 2>&1

# Verificar espaco em disco - A cada hora
0 * * * * root df -h /home/tomelin/rastreador >> ${LOG_DIR}/disk.log 2>&1
