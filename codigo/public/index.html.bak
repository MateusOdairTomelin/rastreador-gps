<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rastreador Veicular - Teste</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      background: white;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      max-width: 600px;
      width: 100%;
      padding: 40px;
    }

    h1 {
      color: #333;
      margin-bottom: 10px;
      font-size: 28px;
    }

    .subtitle {
      color: #666;
      margin-bottom: 30px;
      font-size: 14px;
    }

    .status-box {
      background: #f5f5f5;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
    }

    .status-item {
      display: flex;
      align-items: center;
      margin-bottom: 15px;
      padding: 10px;
      background: white;
      border-radius: 6px;
      border-left: 4px solid #667eea;
    }

    .status-item:last-child {
      margin-bottom: 0;
    }

    .status-icon {
      font-size: 24px;
      margin-right: 15px;
    }

    .status-info {
      flex: 1;
    }

    .status-label {
      font-weight: 600;
      color: #333;
      font-size: 14px;
    }

    .status-value {
      color: #666;
      font-size: 12px;
      margin-top: 4px;
      font-family: monospace;
    }

    .status-ok {
      color: #4caf50;
      font-weight: bold;
    }

    .status-error {
      color: #f44336;
      font-weight: bold;
    }

    .loading {
      color: #ff9800;
      font-weight: bold;
    }

    button {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 10px;
      width: 100%;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }

    button:active {
      transform: translateY(0);
    }

    .terminal {
      background: #1e1e1e;
      color: #00ff00;
      padding: 15px;
      border-radius: 6px;
      font-family: 'Courier New', monospace;
      font-size: 12px;
      max-height: 300px;
      overflow-y: auto;
      margin-top: 20px;
      line-height: 1.6;
    }

    .terminal-line {
      margin-bottom: 4px;
    }

    .terminal-error {
      color: #ff6b6b;
    }

    .terminal-warning {
      color: #ffa500;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🚗 Rastreador Veicular</h1>
    <p class="subtitle">Sistema de Rastreamento com X3Tech XT40 OBD2</p>

    <div class="status-box">
      <div class="status-item">
        <div class="status-icon">🌐</div>
        <div class="status-info">
          <div class="status-label">Servidor HTTP</div>
          <div class="status-value">
            <span id="http-status" class="loading">Testando...</span>
          </div>
        </div>
      </div>

      <div class="status-item">
        <div class="status-icon">🔌</div>
        <div class="status-info">
          <div class="status-label">WebSocket</div>
          <div class="status-value">
            <span id="ws-status" class="loading">Testando...</span>
          </div>
        </div>
      </div>

      <div class="status-item">
        <div class="status-icon">📡</div>
        <div class="status-info">
          <div class="status-label">API REST</div>
          <div class="status-value">
            <span id="api-status" class="loading">Testando...</span>
          </div>
        </div>
      </div>

      <div class="status-item">
        <div class="status-icon">🚗</div>
        <div class="status-info">
          <div class="status-label">Dispositivos</div>
          <div class="status-value">
            <span id="devices-status" class="loading">Testando...</span>
          </div>
        </div>
      </div>
    </div>

    <button onclick="testarConexoes()">🔄 Testar Novamente</button>

    <div class="terminal" id="terminal">
      <div class="terminal-line">Iniciando testes...</div>
    </div>
  </div>

  <script>
    const logTerminal = (mensagem, tipo = 'normal') => {
      const terminal = document.getElementById('terminal');
      const linha = document.createElement('div');
      linha.className = 'terminal-line';

      if (tipo === 'error') {
        linha.className += ' terminal-error';
      } else if (tipo === 'warning') {
        linha.className += ' terminal-warning';
      }

      linha.textContent = '> ' + mensagem;
      terminal.appendChild(linha);
      terminal.scrollTop = terminal.scrollHeight;
    };

    const testarConexoes = async () => {
      logTerminal('Iniciando testes...', 'warning');

      const host = window.location.hostname;
      const porta = window.location.port || 80;

      logTerminal(`Host: ${host}:${porta}`);

      // Teste HTTP
      try {
        logTerminal('Testando HTTP...');
        const resposta = await fetch('/api/status', { method: 'GET' });
        if (resposta.ok) {
          const dados = await resposta.json();
          document.getElementById('http-status').innerHTML = '<span class="status-ok">✅ OK</span>';
          logTerminal('✅ HTTP OK', 'normal');
        }
      } catch (error) {
        document.getElementById('http-status').innerHTML = '<span class="status-error">❌ Erro</span>';
        logTerminal('❌ Erro HTTP: ' + error.message, 'error');
      }

      // Teste API
      try {
        logTerminal('Testando API REST...');
        const resposta = await fetch('/api/dispositivos');
        if (resposta.ok) {
          const dados = await resposta.json();
          document.getElementById('api-status').innerHTML = '<span class="status-ok">✅ OK</span>';
          logTerminal('✅ API OK', 'normal');

          const numDispositivos = dados.dados ? dados.dados.length : 0;
          document.getElementById('devices-status').innerHTML = `<span class="status-ok">✅ ${numDispositivos} dispositivo(s)</span>`;
          logTerminal(`✅ Dispositivos: ${numDispositivos}`, 'normal');
        }
      } catch (error) {
        document.getElementById('api-status').innerHTML = '<span class="status-error">❌ Erro</span>';
        logTerminal('❌ Erro API: ' + error.message, 'error');
      }

      // Teste WebSocket
      try {
        logTerminal('Testando WebSocket...');
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const wsUrl = `${protocol}//${host}:${porta}/ws`;

        logTerminal(`WebSocket URL: ${wsUrl}`);

        const ws = new WebSocket(wsUrl);

        ws.onopen = () => {
          document.getElementById('ws-status').innerHTML = '<span class="status-ok">✅ OK</span>';
          logTerminal('✅ WebSocket OK', 'normal');

          ws.send(JSON.stringify({
            tipo: 'test',
            mensagem: 'Teste de conexão'
          }));

          ws.close();
        };

        ws.onerror = (error) => {
          document.getElementById('ws-status').innerHTML = '<span class="status-error">❌ Erro</span>';
          logTerminal('❌ Erro WebSocket: ' + error.message, 'error');
        };

        // Timeout de 5 segundos
        setTimeout(() => {
          if (ws.readyState !== WebSocket.OPEN) {
            logTerminal('⏱️ WebSocket timeout', 'warning');
          }
        }, 5000);

      } catch (error) {
        document.getElementById('ws-status').innerHTML = '<span class="status-error">❌ Erro</span>';
        logTerminal('❌ Erro ao conectar WebSocket: ' + error.message, 'error');
      }

      logTerminal('Testes concluídos!', 'normal');
    };

    // Executar testes ao carregar
    window.addEventListener('load', testarConexoes);
  </script>
</body>
</html>
